{
  "manifest_version": 3,
  "name": "סדר מהמודל",
  "short_name": "סדר מהמודל",
  "version": "1.1",
  "description": "בתוך המודל: לחיצה אחת, וכל הקבצים החדשים יורדים כקובץ ZIP אחד, מסודרים בתיקיות לפי קורס וסוג. בלי סיסמה.",
  "default_locale": "he",
  "icons": { "48": "icon48.png", "96": "icon96.png", "128": "icon128.png", "256": "icon256.png", "512": "icon512.png" },
  "action": { "default_title": "סדר מהמודל: הורדה מהמודל", "default_icon": { "48": "icon48.png", "96": "icon96.png", "128": "icon128.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [{ "resources": ["moodle_download.js", "zipmode.js"], "matches": ["https://*/*"] }]
}
